{
  "name": "bodbjanar",
  "version": "1.0.0",
  "description": "A Jackbox-style multiplayer web game where players create art and bid on each other's creations in a real-time auction.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bodbjanar/bodbjanar.git"
  },
  "keywords": [
    "game",
    "multiplayer",
    "socket.io",
    "auction",
    "art",
    "party-game"
  ],
  "author": "Nash Auction Contributors",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "nodemon": "^3.0.1"
  }
}
